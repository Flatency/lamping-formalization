import Lamping.Lambda.StandardizationProtection
import Lamping.Lambda.Extraction
namespace Lamping.Lambda
/-- Pick the LO original occurrence among all those genuinely used later. -/
theorem UsedSource.leftmost_exists (ρ : ParallelHistory t u)
    (used : ∃ r : RedexOcc t, UsedSource ρ r) :
    ∃ s : RedexOcc t, UsedSource ρ s ∧
      ∀ r : RedexOcc t, LeftOf r.val s.val → ¬UsedSource ρ r := by
  classical
  let F := (redexPositions t).filter (fun p => ∃ r : RedexOcc t, r.val=p ∧ UsedSource ρ r)
  have someSelected : ∃ r : RedexOcc t, r.val∈F := by
    obtain ⟨r,hr⟩ := used
    exact ⟨r,List.mem_filter.mpr ⟨(mem_redexPositions t r.val).mpr r.property,by simpa using (show ∃ q : RedexOcc t, q.val=r.val ∧ UsedSource ρ q from ⟨r,rfl,hr⟩)⟩⟩
  obtain ⟨s,hs⟩ := leftmost_actual_selected_exists F someSelected
  obtain ⟨r,same,hr⟩ := of_decide_eq_true (List.mem_filter.mp hs.1).2
  have eq : r=s := Subtype.ext same
  subst r
  refine ⟨s,hr,?_⟩
  intro r before usedR
  exact hs.2 r (List.mem_filter.mpr ⟨(mem_redexPositions t r.val).mpr r.property,by simpa using (show ∃ q : RedexOcc t, q.val=r.val ∧ UsedSource ρ q from ⟨r,rfl,usedR⟩)⟩) before

/-- A history that never uses any original redex consists, modulo genuine
empty-selection moves, only of identities. No endpoint-equivalence rule is used. -/
theorem ParallelHistory.no_used (ρ : ParallelHistory t u)
    (unused : ∀ r : RedexOcc t, ¬UsedSource ρ r) :
    ∃ eq : u=t, PermEq ρ (eq.symm ▸ ParallelHistory.nil t) := by
  induction ρ with
  | nil t => exact ⟨rfl,.refl _⟩
  | @cons t v u F step tail ih =>
    have noneSelected : ∀ r : RedexOcc t, r.val∉F := by
      intro r member
      exact unused r ⟨t,v,F,.nil t,step,tail,r,rfl,member,(Derivation.residual_nil r r).mpr rfl⟩
    have same := step.no_actual_endpoint noneSelected
    subst v
    have tailUnused : ∀ r : RedexOcc t, ¬UsedSource tail r := by
      intro r used
      have alive := step.left_residual_iff r (fun q hq => False.elim (noneSelected q hq)) r
      exact unused r (used.prepend (.single step) r (by simpa only [ParallelHistory.single_derivation] using alive.mpr rfl))
    obtain ⟨eq,perm⟩ := ih tailUnused
    subst u
    refine ⟨rfl,?_⟩
    exact PermEq.comp (PermEq.no_actual_selection step noneSelected) perm

/-- A minimal genuinely used source redex can be extracted, with a strict
same-dimension cost decrease and every earlier source cut protected. -/
theorem ParallelHistory.extract_minimal (ρ : ParallelHistory t u)
    (used : ∃ r : RedexOcc t, UsedSource ρ r) :
    ∃ (s : RedexOcc t) (z : Term) (head : BetaAt t s.val z) (tail : ParallelHistory z u),
      PermEq ρ ((ParallelHistory.single (singleContraction head)).append tail) ∧
      tail.length=ρ.length ∧ HistoryCost.ListLt tail.costs ρ.costs ∧
      ∀ r : RedexOcc t, LeftOf r.val s.val → RightHistory r.val ρ := by
  obtain ⟨s,sUsed,minimal⟩ := UsedSource.leftmost_exists ρ used
  have protection : ∀ r : RedexOcc t, LeftOf r.val s.val → RightHistory r.val ρ := by
    intro r before
    apply ρ.right_of_no_used r
    intro q prior
    apply minimal q
    rcases prior with same | left
    · rw [same]; exact before
    · exact left.trans before
  rcases ρ.right_or_kills_left s with safe | ⟨r,prior,usedR,_⟩
  · exact False.elim (safe.not_used_self s sUsed)
  · have same : r=s := by
      rcases prior with same | left
      · exact Subtype.ext same
      · exact False.elim (minimal r left usedR.used)
    subst r
    obtain ⟨v,w,F,pre,step,suffix,q,eq,right,selected,residual⟩ := usedR
    have fixed := (pre.derivation.left_fixed s right.paths_right q).mp residual
    have selectedS : s.val∈F := by rw [←fixed]; exact selected
    obtain ⟨z,head,tail,perm,length,less⟩ := right.pull_selected s rfl step selectedS suffix
    refine ⟨s,z,head,tail,?_,?_,?_,protection⟩
    · rw [eq]; exact perm
    · rw [eq]; exact length
    · rw [eq]; exact less
end Lamping.Lambda

namespace Lamping.Lambda
/-- General standardization existence for arbitrary finite parallel histories.
Selections may contain duplicates and invalid names. The proof extracts a real
minimal old redex and descends a fixed-dimensional reverse cost; its equivalence
is generated by actual parallel-moves tiles, never by a common endpoint. -/
theorem atomic_standardization_exists (ρ : ParallelHistory t u) :
    ∃ σ : ParallelHistory t u, Atomic σ ∧ Standard σ ∧ PermEq ρ σ := by
  classical
  have main (n : Nat) : ∀ c : HistoryCost n, ∀ {t u : Term} (ρ : ParallelHistory t u)
      (length : ρ.length=n),
      HistoryCost.ofList n ρ.costs (ρ.costs_length.trans length)=c →
      ∃ σ : ParallelHistory t u, Atomic σ ∧ Standard σ ∧ PermEq ρ σ := by
    intro c
    apply (HistoryCost.wellFounded n).induction c
    intro c ih t u ρ length cost
    by_cases used : ∃ r : RedexOcc t, UsedSource ρ r
    · obtain ⟨s,z,head,tail,pull,sameLength,less,protection⟩ := ρ.extract_minimal used
      have tailLength : tail.length=n := sameLength.trans length
      let next := HistoryCost.ofList n tail.costs (tail.costs_length.trans tailLength)
      have decrease : HistoryCost.Lt n next c := by
        rw [←cost]
        exact less.toCost n (tail.costs_length.trans tailLength) (ρ.costs_length.trans length)
      obtain ⟨σ,atomic,standard,permuted⟩ := ih next decrease tail tailLength rfl
      let result : ParallelHistory t u := (ParallelHistory.single (singleContraction head)).append σ
      have equivalence : PermEq ρ result := .trans pull (.prepend (.single (singleContraction head)) permuted)
      refine ⟨result,.cons head atomic,?_,equivalence⟩
      apply Standard.cons (singleContraction head) s (leftmost_singleton s)
      · apply DoesNotReturnLeft.of_right s
        intro r before
        exact RightHistory.permutation r (protection r before) equivalence
      · exact standard
    · have noneUsed : ∀ r : RedexOcc t, ¬UsedSource ρ r := fun r hr => used ⟨r,hr⟩
      obtain ⟨same,perm⟩ := ρ.no_used noneUsed
      subst u
      exact ⟨.nil t,.nil t,.nil t,perm⟩
  exact main ρ.length _ ρ rfl rfl

/-- The unrestricted existence interface, forgetting only the additionally
constructed ordinary-singleton representation. -/
theorem standardization_exists (ρ : ParallelHistory t u) :
    ∃ σ : ParallelHistory t u, Standard σ ∧ PermEq ρ σ := by
  obtain ⟨σ,_,standard,perm⟩ := atomic_standardization_exists ρ
  exact ⟨σ,standard,perm⟩
end Lamping.Lambda

