import Lamping.Lambda.ResidualTransport
namespace Lamping.Lambda

/-- Parallel histories keep step boundaries, including empty selections.
 Their realizations are actual beta derivations, not endpoint certificates. -/
inductive ParallelHistory : Term → Term → Type where
  | nil (t) : ParallelHistory t t
  | cons {F : List Path} : ParallelStep F t u → ParallelHistory u v → ParallelHistory t v

namespace ParallelHistory
 def append : ParallelHistory t u → ParallelHistory u v → ParallelHistory t v
   | .nil _, k => k
   | .cons h hs, k => .cons h (append hs k)
 def single (h : ParallelStep F t u) : ParallelHistory t u := .cons h (.nil _)
 def derivation : ParallelHistory t u → Derivation t u
   | .nil t => .nil t
   | .cons h hs => h.derivation.append hs.derivation
 theorem append_assoc (h : ParallelHistory t u) (k : ParallelHistory u v)
     (l : ParallelHistory v w) : (h.append k).append l = h.append (k.append l) := by
   induction h with
   | nil => rfl
   | cons h hs ih => exact congrArg (cons h) (ih k)
 @[simp] theorem append_nil (h : ParallelHistory t u) : h.append (.nil u) = h := by
   induction h with
   | nil => rfl
   | cons h hs ih => exact congrArg (cons h) ih
 theorem derivation_append (h : ParallelHistory t u) (k : ParallelHistory u v) :
     (h.append k).derivation = h.derivation.append k.derivation := by
   induction h with
   | nil => exact (Derivation.nil_append _).symm
   | cons h hs ih =>
     simp only [append, derivation, ih]
     exact (Derivation.append_assoc _ _ _).symm
end ParallelHistory

/-- A parallel-moves square has genuine complete-development sides and uses
 exactly the transported residual selections. Its existence for arbitrary F,G
 is a separate theorem obligation, not a field of permutation equivalence. -/
structure ParallelMovesSquare (F G : List Path) (t u v w : Term) where
  first : ParallelStep F t u
  second : ParallelStep G t v
  afterFirst : ParallelStep (first.residualSet G) u w
  afterSecond : ParallelStep (second.residualSet F) v w

/-- AG5.1.5: least equivalence and composition congruence generated by actual
 parallel moves, identity of development realizations, and empty-step deletion.
 In particular arbitrary histories with a common target are not generators. -/
inductive PermEq : ParallelHistory t u → ParallelHistory t u → Prop where
  | refl (h) : PermEq h h
  | symm : PermEq h k → PermEq k h
  | trans : PermEq h k → PermEq k l → PermEq h l
  | comp : PermEq h k → PermEq h' k' → PermEq (h.append h') (k.append k')
  | development (h k : ParallelStep F t u) :
      PermEq (ParallelHistory.single h) (ParallelHistory.single k)
  | moves (s : ParallelMovesSquare F G t u v w) :
      PermEq ((ParallelHistory.single s.first).append (ParallelHistory.single s.afterFirst))
        ((ParallelHistory.single s.second).append (ParallelHistory.single s.afterSecond))
  | empty (h : ParallelStep [] t t) : PermEq (ParallelHistory.single h) (.nil t)

namespace PermEq
 theorem prepend (h : ParallelHistory t u) (hk : PermEq k l) :
     PermEq (h.append k) (h.append l) := .comp (.refl h) hk
 theorem append {h k : ParallelHistory t u} (hk : PermEq h k) (l : ParallelHistory u v) :
     PermEq (h.append l) (k.append l) := .comp hk (.refl l)

 /-- Induction/elimination makes minimality explicit: every congruence containing
 the three source generators contains PermEq. -/
 theorem least
   (R : {t u : Term} → ParallelHistory t u → ParallelHistory t u → Prop)
   (hr : ∀ {t u} (h : ParallelHistory t u), R h h)
   (hs : ∀ {t u} {h k : ParallelHistory t u}, R h k → R k h)
   (ht : ∀ {t u} {h k l : ParallelHistory t u}, R h k → R k l → R h l)
   (hc : ∀ {t u v} {h k : ParallelHistory t u} {h' k' : ParallelHistory u v},
      R h k → R h' k' → R (h.append h') (k.append k'))
   (hd : ∀ {F t u} (h k : ParallelStep F t u), R (ParallelHistory.single h) (ParallelHistory.single k))
   (hm : ∀ {F G t u v w} (s : ParallelMovesSquare F G t u v w),
      R ((ParallelHistory.single s.first).append (ParallelHistory.single s.afterFirst))
        ((ParallelHistory.single s.second).append (ParallelHistory.single s.afterSecond)))
   (he : ∀ {t} (h : ParallelStep [] t t), R (ParallelHistory.single h) (.nil t))
   (h : PermEq a b) : R a b := by
   induction h with
   | refl h => exact hr h
   | symm _ ih => exact hs ih
   | trans _ _ ih ik => exact ht ih ik
   | comp _ _ ih ik => exact hc ih ik
   | development h k => exact hd h k
   | moves s => exact hm s
   | empty h => exact he h
end PermEq
end Lamping.Lambda


